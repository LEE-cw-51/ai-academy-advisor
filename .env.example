# 로컬(docker compose): 아래 기본값 사용
# Railway 배포: Postgres 플러그인을 붙이면 DATABASE_URL이 자동 주입되므로 직접 설정할 필요 없음
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_academy_advisor

# Railway 대시보드 > Variables에서 직접 설정 (프로덕션 값은 여기에 커밋하지 말 것)
OPENAI_API_KEY=
GROQ_API_KEY=
# Groq Chat Completions는 OpenAI 호환 REST — 기본값 그대로 두면 된다.
GROQ_BASE_URL=https://api.groq.com/openai/v1
# 네이버 검색 오픈 API (https://developers.naver.com 앱 등록 → 검색 API 사용 신청).
# 크롤링이 아니라 공식 API이며 무료 25,000회/일. 전체 학원 1회 수집이 822회(3.3%)다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_BASE_URL=https://openapi.naver.com/v1
SECRET_KEY=

# AI provider 선택 (기본값은 전부 stub — 실제 호출/키 없이 동작).
# LLM_PROVIDER=groq로 켜면 무료 Groq(Llama)를 사용한다. 이때 LLM_MODEL도
# Groq 모델명(예: llama-3.3-70b-versatile)으로 바꿔야 한다.
# EMBEDDING_PROVIDER=openai + VECTOR_STORE=pgvector로 켜면 실제 임베딩/벡터검색을
# 사용한다. 이때 EMBEDDING_MODEL도 text-embedding-3-small(또는 -large)로 바꿔야
# 한다 (OPENAI_API_KEY 필요, dimensions=1024로 truncate되어 EMBEDDING_DIM은 그대로).
# REVIEW_SOURCE=naver로 켜면 네이버 검색 오픈 API(blog/cafearticle)로 리뷰 스니펫을
# 수집한다 (NAVER_CLIENT_ID/SECRET 필요). stub은 결정적 가짜 응답이라 키 없이
# 수집 CLI 전 구간을 돌려볼 수 있다.
LLM_PROVIDER=stub
EMBEDDING_PROVIDER=stub
VECTOR_STORE=stub
REVIEW_SOURCE=stub
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=BAAI/bge-m3
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
# 엔드포인트당 1회 호출에서 받아올 건수 (1~100).
NAVER_DISPLAY=10
# 임베딩 차원 (Review.embedding 의 Vector(dim)과 일치해야 함; 변경 시 마이그레이션 필요)
EMBEDDING_DIM=1024

# 프론트엔드(Next.js) 오리진. 반드시 JSON 배열 형식으로 쓸 것 —
# pydantic-settings가 list[str]을 JSON으로 파싱하므로 콤마 나열은 기동에 실패한다.
# 배포 시 Vercel 도메인을 여기에 추가한다.
CORS_ORIGINS=["http://localhost:3000"]
