# Backend API base URL. 비워 두면(또는 삭제하면) next.config.ts의 rewrites()가
# /api/backend/*를 BACKEND_ORIGIN(기본 http://localhost:8000)으로 프록시한다.
# 로컬 백엔드를 8000이 아닌 다른 포트로 띄웠거나, 프록시를 우회해 직접 호출하고
# 싶을 때만 값을 채운다.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Naver Maps JavaScript API client ID (optional — map shows placeholder if missing)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
