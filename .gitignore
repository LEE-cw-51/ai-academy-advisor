# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv/

# Environment
.env
.env.*
!.env.example

# Docker
*.pid

# IDE
.vscode/
.idea/
*.iml

# Frontend (Next.js)
node_modules/
.next/
frontend/.env*
!frontend/.env.local.example
frontend/out/

# 수집 원본 (네이버 검색 API 응답). 정본이 아니며 커밋하지 않는다 —
# 제3자 저작물 텍스트가 들어 있고, 리뷰 본문은 DB에만 보관한다.
data/raw/

# 공공데이터 원본 다운로드(경기도 학원·교습소 현황 등). 정본은 data/academies/*.json이며
# 원본은 convert_registry CLI의 입력일 뿐이므로 커밋하지 않는다.
*.csv
*.xlsx
!data/academies/**/*.csv

# 로컬 SQLite (개발용 파생 DB). 정본이 아니다.
*.db
*.sqlite3

# OS
.DS_Store
