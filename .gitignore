# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv/

# Environment
.env
.env.*
!.env.example

# Docker
*.pid

# IDE
.vscode/
.idea/
*.iml

# Frontend (Next.js)
node_modules/
.next/
frontend/.env*
!frontend/.env.local.example
frontend/out/

# 수집 원본 (네이버 검색 API 응답). 정본이 아니며 커밋하지 않는다 —
# 제3자 저작물 텍스트가 들어 있고, 리뷰 본문은 DB에만 보관한다.
data/raw/

# 루트에 받아둔 공공데이터 원본(경기도 학원·교습소 현황 등). 정본은 data/academies/*.json이고
# 원본은 convert_registry CLI의 입력일 뿐이라 커밋하지 않는다. (루트만 대상 — 나중에
# 정본으로 커밋할 표 데이터가 생기면 그건 그대로 추적된다.)
/*.csv
/*.xlsx

# 로컬 SQLite (개발용 파생 DB). 정본이 아니다.
*.db
*.sqlite3

# OS
.DS_Store
